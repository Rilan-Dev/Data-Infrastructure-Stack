# Neo4j image version — pinned.
NEO4J_IMAGE=neo4j:2026.06.0-enterprise

# Neo4j Enterprise license agreement.
# `eval` = evaluation/development use; `yes` = commercial license held.
NEO4J_ACCEPT_LICENSE_AGREEMENT=eval

# Binds. Restricted to localhost/Tailscale for security.
# External access via Cloudflare Tunnel or Tailscale only.
NEO4J_BOLT_BIND=0.0.0.0
NEO4J_HTTPS_BIND=0.0.0.0
NEO4J_METRICS_BIND=0.0.0.0
NEO4J_HTTP_BIND=0.0.0.0

# --- Memory (EXAMPLE for a 32 GB RAM / 8 CPU host) ---
# Recalculate for the real host:
#   docker run --rm -e NEO4J_AUTH=none neo4j:2026.06.0-enterprise \
#     neo4j-admin server memory-recommendation --docker
NEO4J_server_memory_heap_initial__size=2G
NEO4J_server_memory_heap_max__size=4G
NEO4J_server_memory_pagecache_size=1G

# --- Resource limits for the container ---
NEO4J_MEM_LIMIT=10G
NEO4J_CPUS=3

# --- Tx-log retention (bounded) ---
NEO4J_db_tx__log_rotation_retention__policy=7 days

# --- Credentials mount paths (secrets) ---
NEO4J_AUTH_FILE=/run/secrets/neo4j_auth

# Advertised Bolt address seen by drivers/Browser. Change this to your
# public hostname (e.g. bolt.example.com:443) if you terminate TLS at a
# reverse proxy / Cloudflare Tunnel. Leave as localhost for local-only use.
NEO4J_BOLT_ADVERTISED_ADDRESS=localhost:7687

# Host UID/GID the container runs as. Neo4j's entrypoint runs as root by
# default and recursively chowns /data, /logs, /conf, and /import to its
# internal `neo4j` user (uid 7474), which locks the host user out of files
# it bind-mounted in. Setting this to your own `id -u`:`id -g` makes the
# entrypoint skip that chown step and run as you instead. Find your values
# with: id -u && id -g
NEO4J_UID=1000
NEO4J_GID=1000
