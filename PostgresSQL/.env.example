# PostgreSQL 16 Environment Variables

# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Memory settings (adjust based on host resources)
POSTGRES_MEMORY=4GB

# Backup settings
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE="0 3 * * *"

# Custom config (see postgres/config/postgresql.conf)
PGDATA=/var/lib/postgresql/data/pgdata

# Image: pgvector/pgvector:pg16 (postgres:16 + pgvector precompiled)
# Extensions auto-installed at startup: uuid-ossp, pgcrypto, pg_trgm, hstore, citext, vector
# See postgres/init/01-create-extensions.sql
