# =============================================================================
# QDRANT PRODUCTION DEPLOYMENT — Single Developer / ≤5 Projects
# Hardware: Xeon E3-1220 v3 (4C/4T), 32GB RAM, 2× HDD
# =============================================================================

# -----------------------------------------------------------------------------
# VERSION PINNING — Test and pin a specific version; DO NOT use 'latest'
# -----------------------------------------------------------------------------
QDRANT_VERSION=v1.12.2-unprivileged

# -----------------------------------------------------------------------------
# STORAGE PATHS — relative to this directory by default (created automatically
# by Docker on first `up`). Override with an absolute path (e.g. a dedicated
# SSD mount like /srv/platform/qdrant) for a real production deployment.
# -----------------------------------------------------------------------------
QDRANT_STORAGE_HOST=./storage
QDRANT_SNAPSHOTS_HOST=./snapshots
QDRANT_TMP_HOST=./tmp

# -----------------------------------------------------------------------------
# NETWORK — Internal only; reverse proxy / apps join this network
# -----------------------------------------------------------------------------
QDRANT_NETWORK_NAME=platform-qdrant

# -----------------------------------------------------------------------------
# RESOURCE LIMITS — Conservative for shared 32GB / 4C server
# Adjust after benchmarking; these leave headroom for Neo4j, Postgres, etc.
# -----------------------------------------------------------------------------
QDRANT_MEM_LIMIT=6g
QDRANT_MEM_RESERVATION=3g
QDRANT_CPUS=1.5
QDRANT_PIDS_LIMIT=256
QDRANT_ULIMIT_NOFILE=65536

# -----------------------------------------------------------------------------
# API KEYS — Generate strong random keys; store in Docker secrets or .env
# NEVER commit real keys to git. Use: openssl rand -base64 32
# -----------------------------------------------------------------------------
# Master/admin key (for migrations, backups, admin UI)
QDRANT_API_KEY=CHANGE_ME_ADMIN_KEY

# Per-project keys (one per project, read/write to own collections)
# Generate: openssl rand -base64 24
QDRANT_PROJECT_A_KEY=CHANGE_ME_PROJECT_A_KEY
QDRANT_PROJECT_B_KEY=CHANGE_ME_PROJECT_B_KEY
QDRANT_PROJECT_C_KEY=CHANGE_ME_PROJECT_C_KEY
QDRANT_PROJECT_D_KEY=CHANGE_ME_PROJECT_D_KEY
QDRANT_PROJECT_E_KEY=CHANGE_ME_PROJECT_E_KEY

# Read-only key (for dashboards, monitoring, CI)
QDRANT_READONLY_KEY=CHANGE_ME_READONLY_KEY

# -----------------------------------------------------------------------------
# QDRANT SERVICE CONFIG — Merged into production.yaml at startup
# -----------------------------------------------------------------------------
QDRANT_HOST=0.0.0.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Telemetry (disable for privacy)
QDRANT_TELEMETRY_DISABLED=true

# Log level
QDRANT_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SNAPSHOT / BACKUP SCHEDULE
# -----------------------------------------------------------------------------
# Cron expression for daily full snapshot (UTC)
QDRANT_SNAPSHOT_CRON="0 3 * * *"

# Retention: keep N local snapshots
QDRANT_SNAPSHOT_RETENTION=7

# Remote backup destination (S3/R2/MinIO) — optional but recommended
# QDRANT_BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# QDRANT_BACKUP_S3_BUCKET=qdrant-backups
# QDRANT_BACKUP_S3_ACCESS_KEY=...
# QDRANT_BACKUP_S3_SECRET_KEY=...
# QDRANT_BACKUP_S3_REGION=auto

# -----------------------------------------------------------------------------
# MONITORING / HEALTH
# -----------------------------------------------------------------------------
QDRANT_HEALTHCHECK_INTERVAL=30s
QDRANT_HEALTHCHECK_TIMEOUT=5s
QDRANT_HEALTHCHECK_RETRIES=5
QDRANT_HEALTHCHECK_START_PERIOD=60s
