# RabbitMQ Environment Variables

# Admin credentials
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=admin

# Resource limits (adjust based on host resources)
RABBITMQ_MEM_LIMIT=1g
RABBITMQ_MEM_RESERVATION=512m
RABBITMQ_CPUS=0.5
RABBITMQ_PIDS_LIMIT=256
RABBITMQ_ULIMIT_NOFILE=65536

# Backup settings
RABBITMQ_BACKUP_RETENTION_DAYS=7
RABBITMQ_BACKUP_SCHEDULE="0 3 * * *"

# Health check settings
RABBITMQ_HEALTHCHECK_INTERVAL=30s
RABBITMQ_HEALTHCHECK_TIMEOUT=10s
RABBITMQ_HEALTHCHECK_RETRIES=5
RABBITMQ_HEALTHCHECK_START_PERIOD=60s
