{
  "uid": "paperclip-credential-broker",
  "title": "Paperclip Credential Broker",
  "description": "Identity availability for the Paperclip GitHub credential broker, split by wake cause. The RILAAA-75 outage looked like one cause flat at 0% while every other cause sat at 100% — the 'Availability by cause' panel is built to make exactly that shape obvious. Runbook: monitoring/README.md",
  "tags": ["platform", "paperclip", "rilaaa-81"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "credential",
        "label": "Credential source",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "platform-prometheus" },
        "query": "label_values(paperclip_identity_context_window_count, credential)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Is the broker working right now?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Unattended runs denied an identity (last 15m)",
      "description": "cause=company_default, status=unavailable. Correct steady state is 0 — anything above zero means unattended engineer heartbeats cannot commit and will fail silently with `fatal: empty ident name`. This is the number PaperclipUnattendedIdentityUnavailable alerts on.",
      "datasource": { "type": "prometheus", "uid": "platform-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(paperclip_identity_context_window_count{credential=~\"$credential\", cause=\"company_default\", status=\"unavailable\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "0", "index": 0 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability by cause (last 1h)",
      "description": "One tile per wake cause, over a 1-hour lookback. A cause sitting at 0% while its neighbours read 100% is the RILAAA-75 signature. Causes with zero successes are plotted as 0%, not dropped — a missing series is what made the original outage invisible. A cause with no attempts at all in the hour is omitted rather than shown as 0%, since availability is undefined with no attempts.",
      "datasource": { "type": "prometheus", "uid": "platform-prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "paperclip:identity_availability_ratio:1h{credential=~\"$credential\"}",
          "legendFormat": "{{cause}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Age of newest identity context",
      "description": "Distinguishes 'broker healthy' from 'nothing is running'. Unattended heartbeats produce a row every 30 minutes, so a value above 2h means the control plane is stopped or every agent is paused — and while that is true, the denial panels above are silent for lack of data rather than lack of a problem. Alerts as PaperclipIdentityContextsStale.",
      "datasource": { "type": "prometheus", "uid": "platform-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(paperclip_identity_context_freshness_seconds)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3600 },
              { "color": "red", "value": 7200 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "type": "row",
      "title": "History",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Identity availability by cause",
      "description": "Rolling 1-hour availability per wake cause, computed from the cumulative counter so the line never breaks. Flat lines at 0 for a single cause are the pattern to look for; a multi-day flat line at 0 is precisely what RILAAA-75 was.",
      "datasource": { "type": "prometheus", "uid": "platform-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "paperclip:identity_availability_ratio:1h{credential=~\"$credential\"}",
          "legendFormat": "{{cause}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "stepAfter"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": []
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["min", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Identity contexts by cause and broker verdict",
      "description": "Raw 15-minute counts. Use this to tell 'the broker is failing' apart from 'barely anything ran' — a low denial count with a low total is a quiet period, not recovery.",
      "datasource": { "type": "prometheus", "uid": "platform-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "paperclip_identity_context_window_count{credential=~\"$credential\"}",
          "legendFormat": "{{cause}} / {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*/ unavailable" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*/ available" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*/ unknown" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Alerting pipeline",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "table",
      "title": "Firing alerts",
      "description": "Live from Prometheus, so it reflects rule state even if Alertmanager delivery is broken.",
      "datasource": { "type": "prometheus", "uid": "platform-prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true },
            "indexByName": { "alertname": 0, "severity": 1, "service": 2, "component": 3, "cause": 4, "status": 5 }
          }
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Can we still see the signal?",
      "description": "Exporter scrape health and Alertmanager notification failures. If either tile is red, the panels above are not trustworthy and no alert will reach anyone.",
      "datasource": { "type": "prometheus", "uid": "platform-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"paperclip-identity\"}) or vector(0)",
          "legendFormat": "exporter scrapeable",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "1 - clamp_max(sum(increase(alertmanager_notifications_failed_total[15m])) or vector(0), 1)",
          "legendFormat": "notifications delivering",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NO", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "yes", "color": "green", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    }
  ]
}
