# =============================================================================
# monitoring/.env.example
#
# Copy to .env (chmod 600) and fill in. `.env` is gitignored; `.env.example`
# holds placeholders only. Never put these values in docker-compose.yml, in a
# Prometheus/Alertmanager config, or in a Grafana dashboard JSON — compose reads
# them from this file at runtime and Grafana's datasource password is written
# with `isSecureJsonData`-equivalent provisioning, so nothing lands in git.
#
# Matching credential copy lives at /docker/credentials/monitoring-credentials.env
# (mode 600), following the convention used by redis/rabbitmq/neo4j in this repo.
# =============================================================================

# --- Paperclip identity-context exporter -------------------------------------
# Read-only role created by scripts/provision-metrics-role.sh. It holds exactly
# one privilege: SELECT on public.run_identity_contexts in the `paperclip` db.
# Generate with: ./scripts/provision-metrics-role.sh --rotate
PAPERCLIP_EXPORTER_USER=paperclip_metrics_ro
PAPERCLIP_EXPORTER_PASSWORD=replace-me-40-char-random
PAPERCLIP_EXPORTER_HOST=postgres-db
PAPERCLIP_EXPORTER_PORT=5432
PAPERCLIP_EXPORTER_DB=paperclip

# --- Grafana -----------------------------------------------------------------
# Bound to 127.0.0.1 only; reach it over an SSH tunnel or put it behind the
# Cloudflare Tunnel before exposing it.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me
GRAFANA_ROOT_URL=http://127.0.0.1:3090/
