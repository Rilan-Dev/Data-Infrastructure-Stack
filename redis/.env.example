# =============================================================================
# REDIS ENVIRONMENT — Shared Infrastructure
# COPY TO .env AND REPLACE ALL PASSWORDS
# =============================================================================

# --- VERSION ---
REDIS_VERSION=7.4.1-alpine

# --- NETWORK ---
REDIS_NETWORK=platform-redis

# --- STORAGE (relative to this directory by default; override with an
# absolute path for a dedicated disk in production) ---
REDIS_DATA_HOST=./data
REDIS_SNAPSHOTS_HOST=./snapshots

# --- RESOURCE LIMITS ---
REDIS_MEM_LIMIT=2g
REDIS_MEM_RESERVATION=1g
REDIS_CPUS=0.5
REDIS_PIDS_LIMIT=128
REDIS_ULIMIT_NOFILE=65536

# --- ACL PASSWORDS (GENERATE WITH: openssl rand -base64 32) ---
REDIS_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
REDIS_PROJECT_A_PASSWORD=CHANGE_ME_PROJECT_A_PASSWORD
REDIS_PROJECT_B_PASSWORD=CHANGE_ME_PROJECT_B_PASSWORD
REDIS_PROJECT_C_PASSWORD=CHANGE_ME_PROJECT_C_PASSWORD
REDIS_PROJECT_D_PASSWORD=CHANGE_ME_PROJECT_D_PASSWORD
REDIS_PROJECT_E_PASSWORD=CHANGE_ME_PROJECT_E_PASSWORD
REDIS_READONLY_PASSWORD=CHANGE_ME_READONLY_PASSWORD

# --- SNAPSHOT/BACKUP ---
REDIS_SNAPSHOT_CRON="0 3 * * *"
REDIS_SNAPSHOT_RETENTION=7

# --- HEALTHCHECK ---
REDIS_HEALTHCHECK_INTERVAL=30s
REDIS_HEALTHCHECK_TIMEOUT=5s
REDIS_HEALTHCHECK_RETRIES=5
REDIS_HEALTHCHECK_START_PERIOD=30s
